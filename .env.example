# ============================================================================
# YGO Card Maker — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA commite o .env (segredos ficam fora do git).
# ============================================================================

# --- aplicação --------------------------------------------------------------
APP_ENV=development          # development | production
LOG_LEVEL=INFO
LOG_FORMAT=json              # json (produção) | pretty (local)

# --- segurança ---------------------------------------------------------------
# Assine com 32+ bytes: openssl rand -hex 32
SECRET_KEY=troque-este-segredo-com-32-bytes-ou-mais
ACCESS_TOKEN_TTL_MINUTES=10080   # 7 dias

# --- URLs públicas ----------------------------------------------------------
# Usadas no link de compartilhamento e na URL das imagens.
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- persistência -----------------------------------------------------------
# sqlite  = desenvolvimento local, zero configuração
# supabase = Postgres gerenciado + Storage (produção)
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/cards.db
UPLOAD_DIR=./data/uploads
MEDIA_BASE_URL=              # vazio => {PUBLIC_BASE_URL}/media

# --- Supabase (necessário apenas com STORAGE_BACKEND=supabase) --------------
# Pegue em: Supabase Dashboard > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # segredo de servidor: NUNCA exponha no front
SUPABASE_BUCKET=card-images

# --- regras de negócio ------------------------------------------------------
MAX_UPLOADS_PER_USER=5       # cota vitalícia de uploads por duelo
IMAGE_OUTPUT_PX=1024         # lado final da arte (quadrado, sem upscale)
MAX_UPLOAD_MB=6
MAX_CARDS_PER_OWNER=200
