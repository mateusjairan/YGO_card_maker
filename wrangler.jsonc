{
  // Publicação como Worker (opcional).
  // No Cloudflare Pages este arquivo é ignorado: lá vale o web/public/_redirects.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygo-card-maker",
  "main": "workers/proxy.js",
  "compatibility_date": "2026-11-16",
  "observability": {
    "enabled": true
  },
  // Keep-alive da API no Render (plano free hiberna após ~15 min ociosos).
  // O handler `scheduled` do Worker só pinga dentro da janela 06h–24h de Brasília.
  // A Cloudflare pode levar até 15 min para propagar um Cron Trigger novo.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // o Worker decide rota por rota (proxy antes do fallback do SPA), senão o
    // índice do SPA pode ser servido no lugar de /c/{slug} e /api/*
    "run_worker_first": true
  }
}
